datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  logoUrl      String?       // Base64 ou URL da imagem/logo da igreja salva no banco
  primaryColor String        @default("#dc2626")
  
  // Informações da Igreja
  pastorName       String?
  phone            String?
  address          String?
  city             String?
  state            String?

  // Configurações de Dízimos e Ofertas PIX
  pixKey           String?
  pixKeyType       String?       @default("CNPJ")
  pixPresetValues  String?       @default("30,50,100,200,500")

  // Assinatura e Planos
  plan         String        @default("GESTAO") // ESSENCIAL, GESTAO, PREMIUM
  status       String        @default("ACTIVE") // ACTIVE, TRIAL, SUSPENDED, CANCELLED
  setupPrice   Float         @default(790)
  monthlyPrice Float         @default(249)
  subscriptionExpiresAt DateTime?
  
  // Hierarquia Matriz -> Filiais (Self-relation)
  parentId     String?
  parent       Tenant?       @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  branches     Tenant[]      @relation("TenantHierarchy")

  users        User[]
  userAccesses UserChurchAccess[]
  cellGroups   CellGroup[]
  ministries   Ministry[]
  videos       ChurchVideo[]
  transactions Transaction[]
  moodCheckIns MoodCheckIn[]
  prayerRequests PrayerRequest[]
  events         Event[]
  agentProfiles        AgentProfile[]
  conversations        Conversation[]
  pastoralAppointments PastoralAppointment[]
  officialDocuments    OfficialDocument[]
  sundaySchoolClasses  SundaySchoolClass[]
  discipleshipTracks   DiscipleshipTrack[]
  assemblies           Assembly[]
  assets               ChurchAsset[]
  worshipServices      WorshipService[]
  serviceAttendances   ServiceAttendance[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id               String      @id @default(cuid())
  name             String
  email            String      @unique
  avatarUrl        String?     // Foto de perfil do usuário (URL ou Base64)
  password         String?     // Senha criptografada (bcrypt)
  role             String      @default("MEMBER") // SUPERADMIN, ADMIN, PASTOR, LEADER, MEMBER
  isEmailVerified  Boolean     @default(false)
  verificationCode String?
  codeExpiresAt    DateTime?
  themePreference  String      @default("system") // system, light, dark
  themePalette     String      @default("default") // default, oled, navy, sepia, cream

  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  churchAccesses   UserChurchAccess[]
  ledCells         CellGroup[] @relation("CellLeader")
  ledMinistries    Ministry[]  @relation("MinistryLeader")
  cpf              String?     // CPF para relatório de Imposto de Renda (IRPF)
  transactions     Transaction[] @relation("MemberTransactions")
  conversations    Conversation[]
  ministryMembers  MinistryMember[]
  assignedTasks    MinistryTask[]

  // Atendimento Pastoral & Agenda
  isPastoralCounselor    Boolean     @default(false)
  isLiveAvailable        Boolean     @default(false)
  pastoralTitle          String?     // ex: "Pastor Titular", "Pastora Auxiliar"
  pastoralBio            String?     // Breve descrição / especialidades
  pastoralPhone          String?     // Contato direto ou WhatsApp
  pastoralScheduleConfig String?     // JSON com dias da semana e horários disponíveis

  pastoralAppointmentsAsPastor PastoralAppointment[] @relation("PastorAppointments")
  pastoralAppointmentsAsMember PastoralAppointment[] @relation("MemberAppointments")

  // Secretaria, Discipulado e Assembleias
  createdOfficialDocuments     OfficialDocument[]    @relation("CreatedOfficialDocuments")
  discipleshipProgress         MemberDiscipleshipProgress[]
  assemblyVotes                AssemblyVote[]
  serviceAttendances           ServiceAttendance[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Ministry {
  id          String   @id @default(cuid())
  name        String
  description String?
  leaderId    String?
  leader      User?    @relation("MinistryLeader", fields: [leaderId], references: [id])
  schedule    String?  // ex: "Domingos às 17h"
  color       String   @default("#8b5cf6")
  icon        String   @default("Sparkles")
  logoUrl     String?  // Imagem/logotipo do ministério
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Workspace de Ministérios
  members     MinistryMember[]
  meetings    MinistryMeeting[]
  tasks       MinistryTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MinistryMember {
  id             String   @id @default(cuid())
  ministryId     String
  ministry       Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String   @default("VOLUNTEER") // LEADER, VOLUNTEER
  customFunction String?  // Ex: "Vocalista", "Baterista", "Intercessor", "Recepção", "Sonoplasta"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ministryId, userId])
}

model MinistryMeeting {
  id          String         @id @default(cuid())
  ministryId  String
  ministry    Ministry       @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  type        String         @default("REUNIAO") // REUNIAO, ENSAIO
  minute      MeetingMinute?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MeetingMinute {
  id          String          @id @default(cuid())
  meetingId   String          @unique
  meeting     MinistryMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content     String          // Texto longo da ata

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MinistryTask {
  id          String    @id @default(cuid())
  ministryId  String
  ministry    Ministry  @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status      String    @default("PENDING") // PENDING, COMPLETED

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserChurchAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN, PASTOR, LEADER, FINANCIAL, KIDS, MEMBER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
}

model CellGroup {
  id        String   @id @default(cuid())
  name      String
  leaderId  String?
  leader    User?    @relation("CellLeader", fields: [leaderId], references: [id])
  address   String?  // Bairro / Endereço
  schedule  String?  // ex: "Quartas às 20h"
  hostName  String?  // Anfitrião da casa
  category  String?  @default("Geral") // Casais, Jovens, Família, Mulheres
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChurchVideo {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String   // URL ou ID do YouTube
  description String?
  preacher    String?  // Pregador / Ministro
  date        String?  // Data do culto
  category    String?  @default("Culto") // Culto de Celebração, Estudo Bíblico, Louvor
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  slogan          String?  // subtítulo curto de impacto
  description     String?
  imageUrl        String?  // banner do evento
  startDate       DateTime
  endDate         DateTime?
  isPublic        Boolean  @default(true)
  isGlobalFeature Boolean  @default(false)
  isActive        Boolean  @default(true) // Master ou Pastor pode ativar e desativar o evento
  isPaid          Boolean  @default(false) // Evento Pago ou Gratuito (RSVP)
  price           Float?   // Preço por ingresso (ex: 150.0)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tickets         Ticket[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Ticket {
  id         String   @id @default(uuid()) // UUID para o QR Code
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerEmail String   // E-mail do comprador
  guestName  String   // Nome na credencial
  status     String   @default("VALID") // VALID, USED, CANCELLED

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([buyerEmail])
  @@index([eventId])
}


model Transaction {
  id            String   @id @default(cuid())
  amount        Float
  type          String   @default("INCOME")    // INCOME (Entrada / Arrecadação), EXPENSE (Saída / Despesa)
  category      String   @default("OFERTA")    // DIZIMO, OFERTA, MISSOES, ALUGUEL, LUZ, SALARIO, SOM, REFORMA, OUTROS
  description   String?                        // Ex: "Conta de Luz de Março", "Dízimo Culto de Celebração"
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  paymentMethod String   @default("PIX")       // PIX, DINHEIRO, CARTAO, BOLETO, TRANSFERENCIA

  // Rastreamento Nominal para fins de Imposto de Renda (IRPF)
  memberId      String?
  member        User?    @relation("MemberTransactions", fields: [memberId], references: [id], onDelete: SetNull)

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Plan {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  subtitle       String?
  badge          String?
  setupPrice     Float
  monthlyPrice   Float
  targetAudience String?
  features       String   // JSON string de recursos
  highlight      Boolean  @default(false)
  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email, code])
}

model EmailLog {
  id        String   @id @default(cuid())
  type      String   @default("OUTGOING") // OUTGOING (SMTP), INCOMING (IMAP)
  from      String
  to        String
  subject   String
  snippet   String?
  status    String   @default("SENT")     // SENT, DELIVERED, FAILED
  code      String?

  createdAt DateTime @default(now())
}

model PromotionConfig {
  id              String   @id @default("default")
  active          Boolean  @default(true)
  badge           String   @default("CONDIÇÃO EXCLUSIVA DE LANÇAMENTO")
  title           String   @default("Programa Especial: Primeiras 100 Igrejas de Outubro/2026")
  description     String   @default("Para as primeiras 100 igrejas parceiras do mês de outubro/2026, oferecemos 50% de desconto na taxa de implantação, acompanhamento presencial na secretaria e treinamento VIP de liderança. Em troca, construiremos juntos seu case de sucesso ministerial.")
  discountPercent Int      @default(50)
  currentCount    Int      @default(63)
  targetCount     Int      @default(100)
  validityText    String   @default("Válido até 31 de Outubro de 2026")
  ctaText         String   @default("Garantir Minha Vaga (50% OFF)")

  updatedAt       DateTime @updatedAt
}

model MoodCheckIn {
  id        String   @id @default(cuid())
  mood      String   // FELIZ, CANSADO, ANSIOSO, TRISTE
  date      DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrayerRequest {
  id              String    @id @default(cuid())
  content         String
  authorName      String?
  authorEmail     String?
  authorPhone     String?
  isAnonymous     Boolean   @default(false)
  isRedAlert      Boolean   @default(false)
  status          String    @default("PENDING") // PENDING, PRAYING, ANSWERED
  responseMessage String?   // Mensagem pastoral / oração enviada pelo pastor/admin
  respondedBy     String?   // Nome do Pastor ou Líder que atendeu
  respondedAt     DateTime? // Data do envio da resposta pastoral
  date            DateTime  @default(now())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// Módulo de IA (Agentes, Orquestrador e Chat)
// ==========================================

model AgentProfile {
  id             String   @id @default(cuid())
  name           String   // Nome do Agente (ex: Orquestrador, Pastor Conselheiro)
  type           String   @default("EXPERT") // ORCHESTRATOR, EXPERT
  systemPrompt   String   // As instruções de como a IA deve se comportar
  model          String   @default("gemini-1.5-flash") // Qual modelo do Gemini usar
  temperature    Float    @default(0.7) // Grau de criatividade
  isActive       Boolean  @default(true)
  
  tenantId       String?  // Se null, é um agente global (Sede/Master). Se preenchido, é específico da filial
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversations  Conversation[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Conversation {
  id             String   @id @default(cuid())
  title          String?  // Título gerado automaticamente pela IA
  
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agentProfileId String?
  agentProfile   AgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)

  messages       Message[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Message {
  id             String   @id @default(cuid())
  role           String   // USER, MODEL, SYSTEM
  content        String
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}

model RolePermission {
  id          String   @id @default(cuid())
  role        String   @unique // ADMIN, PASTOR, LEADER, FINANCIAL, KIDS, MEMBER
  menuItems   String   // JSON string array of allowed menus (e.g., "['/celulas', '/doar']")
  actions     String   @default("[]") // JSON string array of allowed actions (e.g., "['add_video']")
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Módulo de Atendimento Pastoral & Agenda
// ==========================================

model PastoralAppointment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pastorId      String
  pastor        User     @relation("PastorAppointments", fields: [pastorId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?    @relation("MemberAppointments", fields: [userId], references: [id], onDelete: SetNull)

  userName      String
  userEmail     String?
  userPhone     String?

  type          String   @default("LIVE") // "LIVE" (ao vivo agora) ou "SCHEDULED" (agendado)
  scheduledDate String?  // Data no formato YYYY-MM-DD para agendamentos
  scheduledTime String?  // Horário no formato HH:mm (ex: "14:30")
  scheduledAt   DateTime? // DateTime completo para ordenação e filtro

  status        String   @default("WAITING") // "WAITING" (aguardando pastor), "IN_PROGRESS", "COMPLETED", "CANCELLED"
  subject       String?  // Assunto / Motivo inicial
  pastorNotes   String?  // Anotações particulares do pastor (sigilosas)

  messages      PastoralMessage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, pastorId, status])
}

model PastoralMessage {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   PastoralAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  senderId      String?
  senderName    String
  senderRole    String   // "MEMBER" ou "PASTOR"
  content       String

  createdAt     DateTime @default(now())

  @@index([appointmentId])
}

// ==========================================
// 1. SECRETARIA DIGITAL & DOCUMENTOS OFICIAIS
// ==========================================
model OfficialDocument {
  id             String   @id @default(cuid())
  documentNumber String   @unique // ex: DOC-2026-0001
  type           String   // TRANSFER_LETTER, RECOMMENDATION_LETTER, BAPTISM_CERTIFICATE, CHILD_PRESENTATION, MARRIAGE_CERTIFICATE, ORDINATION_CERTIFICATE
  title          String
  recipientName  String
  recipientCpf   String?
  recipientPhone String?
  details        String?  // JSON estruturado com datas, cônjuge, pais, pastor oficiante, etc.
  issuedAt       DateTime @default(now())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?    @relation("CreatedOfficialDocuments", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, type])
}

// ==========================================
// 2. ESCOLA BÍBLICA DOMINICAL (EBD) & DISCIPULADO
// ==========================================
model SundaySchoolClass {
  id          String   @id @default(cuid())
  name        String   // ex: "Jovens e Universitários", "Casais", "Novos Convertidos"
  description String?
  room        String?  // ex: "Sala 03 - Térreo"
  ageRange    String?  // ex: "18 a 29 anos"
  teacherName String?  // Nome do professor/líder
  teacherId   String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances SundaySchoolAttendance[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model SundaySchoolAttendance {
  id             String            @id @default(cuid())
  classId        String
  class          SundaySchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  date           DateTime          @default(now())
  lessonTitle    String?           // Título da lição / revista
  totalMembers   Int               @default(0)
  totalVisitors  Int               @default(0)
  biblesCount    Int               @default(0)
  magazinesCount Int               @default(0)
  offeringAmount Float             @default(0)
  notes          String?
  recordedBy     String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([classId, date])
}

model DiscipleshipTrack {
  id          String            @id @default(cuid())
  title       String            // ex: "Trilha do Novo Convertido - Primeiros Passos"
  description String?
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       DiscipleshipStep[]
  members     MemberDiscipleshipProgress[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
}

model DiscipleshipStep {
  id          String            @id @default(cuid())
  trackId     String
  track       DiscipleshipTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title       String            // 1. Acolhimento, 2. Batismo, 3. Doutrinas, 4. Célula e Ministério
  order       Int               @default(0)
  description String?
  checklist   String?           // JSON array de itens
}

model MemberDiscipleshipProgress {
  id           String            @id @default(cuid())
  trackId      String
  track        DiscipleshipTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStep  Int               @default(1)
  status       String            @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  completedAt  DateTime?
  mentorName   String?
  notes        String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([trackId, userId])
  @@index([userId])
}

// ==========================================
// 3. ASSEMBLEIAS ESTATUTÁRIAS & VOTAÇÃO COM QUÓRUM
// ==========================================
model Assembly {
  id                    String               @id @default(cuid())
  title                 String               // ex: "Assembleia Geral Ordinária de Eleição e Posse 2026"
  date                  DateTime
  type                  String               @default("ORDINARY") // ORDINARY, EXTRAORDINARY
  status                String               @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, CLOSED
  requiredQuorumPercent Int                  @default(50) // ex: 50% + 1
  description           String?
  totalEligibleMembers  Int                  @default(0) // total de membros aptos
  minutesSummary        String?              // Ata gerada automaticamente
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItems           AssemblyAgendaItem[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([tenantId, status])
}

model AssemblyAgendaItem {
  id          String         @id @default(cuid())
  assemblyId  String
  assembly    Assembly       @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  order       Int            @default(1)
  title       String         // ex: "Aprovação do Relatório Financeiro e Contas"
  description String?
  voteType    String         @default("OPEN") // OPEN, SECRET
  status      String         @default("PENDING") // PENDING, VOTING, CLOSED
  votes       AssemblyVote[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([assemblyId])
}

model AssemblyVote {
  id           String             @id @default(cuid())
  agendaItemId String
  agendaItem   AssemblyAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteChoice   String             // YES, NO, ABSTAIN
  votedAt      DateTime           @default(now())

  @@unique([agendaItemId, userId])
  @@index([agendaItemId])
}

// ==========================================
// 4. PATRIMÔNIO & INVENTÁRIO FÍSICO
// ==========================================
model ChurchAsset {
  id             String   @id @default(cuid())
  code           String   @unique // ex: PAT-00124 (número de tombamento)
  name           String   // ex: "Mesa de Som Behringer X32"
  category       String   // AUDIO_VISUAL, INSTRUMENT, FURNITURE, CLIMATE, VEHICLE, REAL_ESTATE, IT
  invoiceNumber  String?  // Número da NF
  purchaseDate   DateTime?
  purchaseValue  Float    @default(0)
  currentValue   Float?
  location       String   // ex: "Nave Principal", "Sala Infantil"
  condition      String   @default("GOOD") // NEW, GOOD, NEEDS_REPAIR, RETIRED
  serialNumber   String?
  photoUrl       String?
  notes          String?
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, category])
}

// ==========================================
// 5. CULTOS & PORTEIRO DIGITAL (CHECK-IN)
// ==========================================
model WorshipService {
  id          String   @id @default(cuid())
  title       String   // ex: "Culto de Celebração de Domingo", "Culto de Doutrina e Ensino"
  dayOfWeek   String?  // DOMINGO, SEGUNDA, TERCA, QUARTA, QUINTA, SEXTA, SABADO
  time        String?  // ex: "18:00", "19:30"
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances ServiceAttendance[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model ServiceAttendance {
  id          String          @id @default(cuid())
  serviceId   String?
  service     WorshipService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String          // Nome do culto ou evento no momento do registro
  serviceDate String          // YYYY-MM-DD
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkedInBy String?         // Nome do porteiro/recepcionista
  checkedInAt DateTime        @default(now())
  notes       String?

  @@unique([tenantId, serviceId, userId, serviceDate])
  @@index([tenantId, serviceDate])
  @@index([userId])
}



